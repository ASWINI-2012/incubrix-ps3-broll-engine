# Select auto, public, demo, pixabay, or pexels. Auto searches Wikimedia Commons and Internet Archive without keys.
BROLL_PROVIDER=auto
# Optional: auto also searches these providers when configured.
PIXABAY_API_KEY=
PEXELS_API_KEY=
MEDIA_API_TIMEOUT_SECONDS=20
# Required for Wikimedia Commons: descriptive application name plus your real contact email or website.
# Commons requests are skipped until this is configured; do not use a fabricated contact.
MEDIA_API_USER_AGENT=
FOOTAGE_CACHE_DIR=./data/media_library/download_cache
DATABASE_PATH=./data/jobs.sqlite3
OUTPUT_DIR=./outputs
MEDIA_LIBRARY_DIR=./data/media_library
MEDIA_MAX_FILES_PER_RUN=20
MEDIA_MAX_FILE_BYTES=52428800
MEDIA_MAX_CLIP_SECONDS=90
MEDIA_MAX_STORAGE_BYTES=2147483648
MEDIA_REQUEST_INTERVAL_SECONDS=0.5
MIN_FOOTAGE_RELEVANCE=0.30
MAX_BLACK_FRAME_FRACTION=0.25
MAX_UPLOAD_BYTES=52428800
MAX_AUDIO_SECONDS=600
PEXELS_TIMEOUT_SECONDS=20
PIXABAY_TIMEOUT_SECONDS=20
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional local image generation through AUTOMATIC1111's Stable Diffusion WebUI API.
# Install a model locally, start WebUI with --api, then set this backend explicitly.
IMAGE_GENERATION_BACKEND=
IMAGE_GENERATION_URL=http://127.0.0.1:7860
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=
IMAGE_GENERATION_RESOLUTION=512
IMAGE_GENERATION_STEPS=20
IMAGE_GENERATION_TIMEOUT_SECONDS=300
CORS_ORIGINS=http://localhost:5173
